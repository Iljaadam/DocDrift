[Unit]
Description=DocDrift bounded judge repair worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=@NEBIUS_ENV@
ExecStart=@PYTHON@ -m docdrift.judge_service worker --state-root @STATE_ROOT@ --authorization @AUTHORIZATION@ --live
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
Nice=10
CPUQuota=50%
MemoryMax=384M
TasksMax=32
LimitNOFILE=1024
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@STATE_ROOT@
InaccessiblePaths=@PRIVATE_FILES@

[Install]
WantedBy=default.target
